+
+    # 2. Flexible dashes or markdown: -- category -- or **category**
+    m = re.search(r'[-*]{2}\s*([a-zA-Z_]+)\s*[-*]{2}', response_category)
+    if m:
+        c = m.group(1).strip().lower()
+        if c in valid_categories:
+            return c
+
+    # 3. [Category] category_name or Category: category_name
+    m = re.search(r'\[Category\]\s*:?\s*-*\s*([a-zA-Z_]+)', response_category, re.IGNORECASE)
