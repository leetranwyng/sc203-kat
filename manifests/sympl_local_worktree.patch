+        if c in valid_categories:
+            return c
+
+    # 4. Word boundary match in response
+    for valid_c in valid_categories:
+        if re.search(r'\b' + valid_c + r'\b', response_category.lower()):
+            return valid_c
+
+    # 5. Question heuristic fallback
+    p_lower = prompt.lower()
+    if 'visible' in p_lower or 'visibility' in p_lower:
